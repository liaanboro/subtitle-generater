{
  "id": "com.example.aisubtitlestudio",
  "name": "AI Subtitle Studio",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PPRO",
      "minVersion": "22.0.0"
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "plugin",
    "allowCodeGenerationFromStrings": true
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "aisubtitlestudio",
      "label": {
        "default": "AI Subtitle Studio"
      },
      "minimumSize": {"width": 300, "height": 400},
      "maximumSize": {"width": 2000, "height": 2000}
    }
  ],
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icon.png",
      "scale": [1, 2],
      "theme": ["dark", "light"]
    }
  ]
}
